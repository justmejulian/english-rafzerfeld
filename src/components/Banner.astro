---
import Container from '@components/Container.astro';

interface Props {
  message: string;
  linkText: string;
  linkUrl: string;
}

const { message, linkText, linkUrl } = Astro.props;
---

<div class="bg-accent text-brand-950">
  <Container class="py-2.5 text-center text-sm font-medium sm:text-base">
    <span>{message}</span>
    <a
      href={linkUrl}
      class="ml-1 inline-flex items-center gap-1 font-semibold underline"
    >
      {linkText}
      <span aria-hidden="true">→</span>
    </a>
  </Container>
</div>
