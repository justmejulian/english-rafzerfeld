---
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';

interface Props {
  title: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const {
  title,
  text,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<Section bg="brand">
  <div class="mx-auto max-w-xl text-center">
    <SectionHeading title={title} tone="light" align="center" />
    <p class="mt-4 text-white/80">{text}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={primaryHref} variant="accent">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="outline-light">
        {secondaryLabel}
      </Button>
    </div>
  </div>
</Section>
