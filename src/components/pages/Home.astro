---
import Layout from '@layouts/Layout.astro';

import Banner from '@components/Banner.astro';
import Hero from '@components/Hero.astro';
import TeachersSection from '@components/TeachersSection.astro';

import { getContent } from '@utils/locale.ts';

import Fees from '@components/sections/Fees.astro';
import Courses from '@components/sections/Courses.astro';
import Levels from '@components/sections/Levels.astro';
import Contact from '@components/sections/Contact.astro';

import { homeSchema } from '@content/schemas.ts';
import data from '@content/home.json';
import teamData from '@content/team.json';

import vinyard from 'public/assets/bgVineyard.jpg';

const { locale, content } = getContent(Astro.url, homeSchema, data);
const teachers = teamData[locale].teachers;
const teamHref = `/${locale}/team`;
---

<Layout locale={locale}>
  {
    content.banner && (
      <Banner
        slot="banner"
        message={content.banner.message}
        linkText={content.banner.linkText}
        linkUrl={content.banner.linkUrl}
      />
    )
  }

  <Hero
    eyebrow={content.eyebrow}
    title={content.title}
    intro={content.intro}
    pills={content.pills}
    coursesCta={content.coursesCta}
    askCta={content.askCta}
    image={vinyard}
  />

  <TeachersSection
    title={content.teachers.title}
    teachers={teachers}
    tagline={content.teachers.tagline}
    cta={content.teachers.cta}
    href={teamHref}
  />

  <Courses />
  <Levels />
  <Fees />
  <Contact />
</Layout>
