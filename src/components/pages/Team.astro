---
import Layout from '@layouts/Layout.astro';
import Section from '@components/Section.astro';
import PageHeader from '@components/PageHeader.astro';
import CtaSection from '@components/CtaSection.astro';

import { getContent } from '@utils/locale.ts';

import { teamSchema } from '@content/schemas.ts';
import data from '@content/team.json';

const { locale, content } = getContent(Astro.url, teamSchema, data);

const contactHref = `/${locale}/#contact`;
const coursesHref = `/${locale}/#courses`;
---

<Layout locale={locale}>
  <PageHeader title={content.title} />

  <Section bg="cream">
    <div class="flex flex-col gap-16">
      {
        content.teachers.map((teacher, i) => (
          <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
            <div
              class:list={[
                'overflow-hidden rounded-2xl shadow-sm',
                { 'md:order-2': i % 2 === 1 },
              ]}
            >
              <img
                src={teacher.image}
                alt={teacher.name}
                class="aspect-4/5 w-full object-cover"
              />
            </div>

            <div>
              <h2>{teacher.name}</h2>
              <p class="text-brand-700 mb-4 text-sm font-semibold">
                {teacher.tagline}
              </p>
              <p class="text-ink/80">{teacher.description}</p>

              <h3 class="mt-6 mb-3 text-lg">{content.qualificationsTitle}</h3>
              <ul class="flex flex-col gap-2">
                {teacher.certificates.map((cert) => (
                  <li class="text-ink/80 flex items-start gap-2 text-sm">
                    <span class="text-accent mt-0.5" aria-hidden="true">
                      ✓
                    </span>
                    {cert.name}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaSection
    title={content.meet.title}
    text={content.meet.text}
    primaryHref={contactHref}
    primaryLabel={content.meet.contactCta}
    secondaryHref={coursesHref}
    secondaryLabel={content.meet.coursesCta}
  />
</Layout>
