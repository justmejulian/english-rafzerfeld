---
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';

import { getLocaleData, getLocaleFromURL } from '@utils/locale.ts';

import { teamSchema } from '@content/schemas.ts';
import data from '@content/team.json';

const locale = getLocaleFromURL(Astro.url);

const content = getLocaleData(locale, teamSchema.parse(data));

const contactHref = `/${locale}/#contact`;
const coursesHref = `/${locale}/#courses`;
---

<Layout locale={locale}>
  <!-- Header -->
  <section class="bg-brand-900 text-white">
    <Container class="py-16 sm:py-20">
      <h1 class="text-white">{content.title}</h1>
    </Container>
  </section>

  <Section bg="cream">
    <div class="flex flex-col gap-16">
      {
        content.teachers.map((teacher, i) => (
          <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
            <div
              class:list={[
                'overflow-hidden rounded-2xl shadow-sm',
                { 'md:order-2': i % 2 === 1 },
              ]}
            >
              <img
                src={teacher.image}
                alt={teacher.name}
                class="aspect-4/5 w-full object-cover"
              />
            </div>

            <div>
              <h2>{teacher.name}</h2>
              <p class="text-brand-700 mb-4 text-sm font-semibold">
                {teacher.tagline}
              </p>
              <p class="text-ink/80">{teacher.description}</p>

              <h3 class="mt-6 mb-3 text-lg">{content.qualificationsTitle}</h3>
              <ul class="flex flex-col gap-2">
                {teacher.certificates.map((cert) => (
                  <li class="text-ink/80 flex items-start gap-2 text-sm">
                    <span class="text-accent mt-0.5" aria-hidden="true">
                      ✓
                    </span>
                    {cert.name}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Meet us CTA -->
  <Section bg="brand">
    <div class="mx-auto max-w-xl text-center">
      <SectionHeading title={content.meet.title} tone="light" align="center" />
      <p class="mt-4 text-white/80">{content.meet.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={contactHref} variant="accent"
          >{content.meet.contactCta}</Button
        >
        <Button href={coursesHref} variant="outline-light">
          {content.meet.coursesCta}
        </Button>
      </div>
    </div>
  </Section>
</Layout>
