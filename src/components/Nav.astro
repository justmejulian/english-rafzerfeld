---
import Container from '@components/Container.astro';
import LanguageButton from './LanguageButton.astro';
import MobileNav from './preact/MobileNav.tsx';

interface Props {
  title: string;
  locale: 'en' | 'de';
}

const { title, locale } = Astro.props;

const linksLocale = {
  en: {
    home: '/en/',
    links: [
      { href: '/en/#courses', label: 'Courses' },
      { href: '/en/#levels', label: 'Levels' },
      { href: '/en/#fees', label: 'Fees' },
      { href: '/en/team', label: 'Team' },
    ],
    contact: { href: '/en/#contact', label: 'Contact us' },
    homeLabel: 'Home',
    menuLabel: 'Toggle menu',
  },
  de: {
    home: '/de/',
    links: [
      { href: '/de/#courses', label: 'Kurse' },
      { href: '/de/#levels', label: 'Niveaus' },
      { href: '/de/#fees', label: 'Preise' },
      { href: '/de/team', label: 'Team' },
    ],
    contact: { href: '/de/#contact', label: 'Kontakt' },
    homeLabel: 'Startseite',
    menuLabel: 'Menü öffnen oder schließen',
  },
};

const { home, links, contact, homeLabel, menuLabel } = linksLocale[locale];

// Full list (incl. Home + Contact) for the mobile menu.
const mobileLinks = [{ href: home, label: homeLabel }, ...links, contact];
---

<header class="bg-brand-900 sticky top-0 z-50 text-white">
  <Container class="flex h-16 items-center justify-between">
    <a
      class="flex items-center transition hover:opacity-80"
      href={home}
      aria-label={title}
    >
      <img class="h-9 w-auto" src="/assets/logo.png" alt={title} />
    </a>

    <nav aria-label="Global" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-medium">
        <li>
          <a class="hover:text-accent text-white transition" href={home}>
            {homeLabel}
          </a>
        </li>
        {
          links.map((link) => (
            <li>
              <a
                class="hover:text-accent text-white transition"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <LanguageButton />

      <a
        href={contact.href}
        class="hover:bg-cream-100 text-brand-900 hidden rounded-full bg-white px-5 py-2 text-sm font-semibold transition md:inline-flex"
      >
        {contact.label}
      </a>

      <div class="block md:hidden">
        <MobileNav links={mobileLinks} menuLabel={menuLabel} client:visible />
      </div>
    </div>
  </Container>
</header>
