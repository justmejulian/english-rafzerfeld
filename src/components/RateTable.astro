---
interface Props {
  headers: string[];
  rows: (string | number)[][];
}

const { headers, rows } = Astro.props;

const thClass =
  'px-3 py-2 text-left text-xs font-semibold text-muted uppercase tracking-wide';
const tdClass = 'px-3 py-2 whitespace-nowrap text-sm font-medium text-ink';
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b border-black/10">
        {headers.map((header) => <th class={thClass}>{header}</th>)}
      </tr>
    </thead>
    <tbody class="divide-y divide-black/5">
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td class={tdClass}>{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
