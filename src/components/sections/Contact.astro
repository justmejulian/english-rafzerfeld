---
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import ContactCard from '@components/ContactCard.astro';
import Map from '@components/Map.astro';

import { getContent } from '@utils/locale.ts';

import { contactSchema } from '@content/schemas.ts';
import data from '@content/contact.json';

const { content } = getContent(Astro.url, contactSchema, data);

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(content.address)}`;
---

<Section id="contact" bg="brand">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
    <div>
      <SectionHeading title={content.title} tone="light" />
      <p class="mt-4 max-w-md text-white/80">{content.description}</p>

      <div class="mt-6">
        <Button href={`mailto:${content.email}`} variant="accent">
          {content.email}
        </Button>
      </div>

      <div class="mt-8">
        <p class="text-white">{content.address}</p>
        <a
          href={mapsUrl}
          rel="noreferrer"
          target="_blank"
          class="text-accent hover:text-accent-soft mt-1 inline-flex items-center gap-1 text-sm font-semibold"
        >
          {content.mapsLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      {
        content.teachersContact.map((teacher) => (
          <ContactCard
            name={teacher.name}
            email={teacher.email}
            phone={teacher.phone}
          />
        ))
      }
    </div>
  </div>

  <div class="mt-10 overflow-hidden rounded-2xl border border-white/15">
    <Map />
  </div>
</Section>
