---
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Tag from '@components/Tag.astro';

import { getLocaleData, getLocaleFromURL } from '@utils/locale.ts';

import { coursesSchema } from '@content/schemas.ts';
import data from '@content/courses.json';

const locale = getLocaleFromURL(Astro.url);

const content = getLocaleData(locale, coursesSchema.parse(data));
---

<Section id="levels" bg="cream-100">
  <SectionHeading title={content.levelsTitle} />
  <p class="text-muted mt-2 max-w-2xl">{content.levelsDescription}</p>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    {
      content.levels.map((level) => (
        <div class="flex flex-col rounded-2xl border border-black/5 bg-white p-6">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <h3 class="text-lg">{level.name}</h3>
            <span class="text-muted text-sm">· {level.userType}</span>
            <div class="ml-auto flex gap-1.5">
              {level.subLevels.map((sub) => (
                <Tag variant="cefr">{sub.cefr}</Tag>
              ))}
            </div>
          </div>
          <p class="text-muted mb-5 text-sm">{level.description}</p>

          <div class="mt-auto flex flex-col gap-4 border-t border-black/5 pt-5">
            {level.subLevels.map((sub) => (
              <div>
                <p class="text-ink mb-1 flex items-center gap-2 text-sm font-semibold">
                  <Tag variant="cefr">{sub.cefr}</Tag>
                  {sub.label}
                </p>
                <p class="text-muted text-sm">{sub.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
