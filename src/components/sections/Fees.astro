---
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import FeeCard from '@components/FeeCard.astro';

import { getContent } from '@utils/locale.ts';

import { feesSchema } from '@content/schemas.ts';
import data from '@content/fees.json';

const { content } = getContent(Astro.url, feesSchema, data);
const { labels } = content;
---

<Section id="fees" bg="white">
  <SectionHeading title={content.title} />
  <p class="text-muted mt-2">{content.note}</p>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <FeeCard
      title={content.groupCoursesTitle}
      description={content.groupCoursesDescription}
      headers={[labels.lesson, labels.standard, labels.reduced]}
      rows={content.groupCourses.map((course) => [
        `${course.length} min`,
        `CHF ${course.normalRate}`,
        `CHF ${course.reducedRate}`,
      ])}
      notes={content.groupCoursesNotes}
    />

    <FeeCard
      title={content.privateCoursesTitle}
      description={content.privateCoursesDescription}
      headers={[
        labels.lesson,
        labels.person,
        labels.twoPeople,
        labels.threePeople,
      ]}
      rows={content.privateCourses.map((course) => [
        `${course.length} min`,
        `CHF ${course.onePersonRate}`,
        `CHF ${course.twoPersonsRate}`,
        `CHF ${course.threePersonsRate}`,
      ])}
      notes={content.privateCoursesNotes}
    />
  </div>
</Section>
