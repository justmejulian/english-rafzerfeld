---
import { z } from 'astro:content';

import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Tag from '@components/Tag.astro';

import { multiLingualSchema } from '@utils/zod.ts';
import { getLocaleData, getLocaleFromURL } from '@utils/locale.ts';

import data from '@content/courses.json';

const locale = getLocaleFromURL(Astro.url);

const contentSchema = multiLingualSchema(
  z.object({
    title: z.string(),
    subtitle: z.string(),
    levelNoteText: z.string(),
    levelNoteLink: z.string(),
    days: z.array(
      z.object({
        name: z.string(),
        note: z.string().optional(),
        lessons: z.array(
          z.object({
            time: z.string(),
            level: z.string(),
            location: z.string().optional(),
            ceflevel: z.string(),
          }),
        ),
      }),
    ),
  }),
);

const content = getLocaleData(locale, contentSchema.parse(data));

const classWord = (n: number) =>
  locale === 'de'
    ? `${n} ${n === 1 ? 'Kurs' : 'Kurse'}`
    : `${n} ${n === 1 ? 'class' : 'classes'}`;

const levelsHref = `/${locale}/#levels`;
---

<Section id="courses" bg="white">
  <SectionHeading title={content.title} />
  <p class="text-muted mt-2 max-w-2xl">{content.subtitle}</p>
  <p class="text-muted mt-1 max-w-2xl text-sm">
    {content.levelNoteText}{' '}
    <a href={levelsHref} class="text-brand-700 font-semibold underline">
      {content.levelNoteLink}
    </a>
  </p>

  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      content.days.map((day) => (
        <div class="bg-cream flex flex-col rounded-2xl border border-black/5 p-5">
          <div class="mb-4 flex items-baseline justify-between border-b border-black/5 pb-3">
            <h3 class="text-lg">{day.name}</h3>
            <span class="text-muted text-xs font-medium">
              {day.note ?? classWord(day.lessons.length)}
            </span>
          </div>
          <ul class="flex flex-col gap-3">
            {day.lessons.map((lesson) => (
              <li class="flex items-center justify-between gap-3">
                <div>
                  <p class="text-ink text-sm font-semibold">{lesson.time}</p>
                  <p class="text-muted text-sm">
                    {lesson.level}
                    {lesson.location && ` · ${lesson.location}`}
                  </p>
                </div>
                <Tag variant="cefr">{lesson.ceflevel}</Tag>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
