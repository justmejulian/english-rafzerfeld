---
interface Props {
  name: string;
  email: string;
  phone: string;
}

const { name, email, phone } = Astro.props;
---

<div class="rounded-2xl border border-white/15 bg-white/5 p-6">
  <h3 class="mb-3 text-white">{name}</h3>
  <div class="flex flex-col gap-1.5 text-sm">
    <a
      href={`mailto:${email}`}
      class="text-accent hover:text-accent-soft break-all"
    >
      {email}
    </a>
    <a
      href={`tel:${phone.replace(/\s+/g, '')}`}
      class="text-white/80 hover:text-white"
    >
      {phone}
    </a>
  </div>
</div>
